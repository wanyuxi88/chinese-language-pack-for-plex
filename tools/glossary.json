 "style": [
  {
   "id": "QUOTE",
   "rule": "中文引号用 “ ”，不用半角 \" 和 '"
  },
  {
   "id": "PHSPACE",
   "rule": "占位符两侧留空格：`{count} 个项目`，链接标记 {1}文本{2} 不留空格"
  },
  {
   "id": "NUMSPACE",
   "rule": "数字与汉字之间留空格：`20 Mbps`、`4 位 PIN 码`；「4月」「2024年」这类日期不空格"
  },
  {
   "id": "ELLIPSIS",
   "rule": "省略号用「…」，不用三个半角点"
  },
  {
   "id": "PERIOD",
   "rule": "英文原文以句号结尾的，中文补「。」"
  },
  {
   "id": "AMP",
   "rule": "& 译作「与」，不保留半角 &"
  },
  {
   "id": "YOU",
   "rule": "人称统一「您」（“你们”除外）"
  },
  {
   "id": "PUNCT",
   "rule": "中文语境不用半角 , ; : ! ?"
  },
  {
   "id": "EMPTY",
   "rule": "空状态统一「暂无」：No results→暂无结果、No options→暂无选项；整句叙述中的「没有」不受此限"
  },
  {
   "id": "MONTH",
   "rule": "%b 短格式位（Jan–Dec）用「1月–12月」，全称（January）才用「一月」；星期同理：Mon→周一、Monday→星期一"
  },
  {
   "id": "PRON",
   "rule": "指示代词 this 统一「此」，不用「该」（「应该 / 不该 / 该……了」等动词用法不受此限）"
  }
 ],
 "exceptions": [
